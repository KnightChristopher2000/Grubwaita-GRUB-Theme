# Grubwaita GRUB Theme 1.0.0
# Dynamically generated per resolution from an editable source template.
title-text: ""
desktop-image: "background.png"
desktop-image-scale-method: "stretch"
desktop-color: "#081019"
terminal-font: "Fira Code Retina @TERMINAL_FONT@"
terminal-left: "10%"
terminal-top: "12%"
terminal-width: "80%"
terminal-height: "75%"
terminal-border: "0"

# Centered main heading
+ label {
    left = 15%
    top = 16%
    width = 70%
    height = 8%
    align = "center"
    text = "Choose your operating system"
    font = "Cantarell Bold @TITLE_FONT@"
    color = "#FFFFFF"
}

# Adwaita-style dark menu background (static)
+ image {
    left = 25%
    top = 29.5%
    width = 50%
    height = 41%
    file = "panel.png"
}

# Actual bootable GRUB entries (dynamic)
+ boot_menu {
    left = 28.5%
    top = 35.8%
    width = 43%
    height = 29.5%
    item_font = "Cantarell Bold @ITEM_FONT@"
    selected_item_font = "Cantarell Bold @ITEM_FONT@"
    item_color = "#F6F6F6"
    selected_item_color = "#FFFFFF"
    icon_width = @ICON_SIZE@
    icon_height = @ICON_SIZE@
    item_icon_space = @ICON_GAP@
    item_height = @ITEM_HEIGHT@
    item_padding = @ITEM_PADDING@
    item_spacing = @ITEM_SPACING@
    selected_item_pixmap_style = "select_*.png"
    scrollbar = "false"
}

# Decorative (not clickable) GNOME-style controls
+ image {
    left = 38%
    top = 78.3%
    width = 2.6%
    height = 4.6%
    file = "back.png"
}
+ image {
    left = 49%
    top = 78.3%
    width = 2.6%
    height = 4.6%
    file = "settings.png"
}
+ image {
    left = 60%
    top = 78.3%
    width = 2.6%
    height = 4.6%
    file = "terminal.png"
}

# Countdown capsule
+ image {
    left = 36.3%
    top = 88%
    width = 27.4%
    height = 10%
    file = "countdown-pill.png"
}
+ image {
    left = 39.4%
    top = 90.2%
    width = 2.6%
    height = 4.6%
    file = "timer.png"
}
+ label {
    id = "__timeout__"
    left = 43.5%
    top = 90.8%
    width = 19.5%
    height = 5%
    align = "left"
    text = "Boot after %d seconds..."
    font = "Cantarell Bold @TIMEOUT_FONT@"
    color = "#FFFFFF"
}
